{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/merchant-onboarding-platform/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/merchant-onboarding-platform/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/merchant-onboarding-platform",
  "projects": {
    "merchant-onboarding-platform": {
      "type": "application",
      "root": "apps/merchant-onboarding-platform",
      "entryFile": "main",
      "sourceRoot": "apps/merchant-onboarding-platform/src",
      "compilerOptions": {
        "tsConfigPath": "apps/merchant-onboarding-platform/tsconfig.app.json"
      }
    },
    "risk-review-worker": {
      "type": "application",
      "root": "apps/risk-review-worker",
      "entryFile": "main",
      "sourceRoot": "apps/risk-review-worker/src",
      "compilerOptions": {
        "tsConfigPath": "apps/risk-review-worker/tsconfig.app.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "typeorm-source": {
      "type": "library",
      "root": "libs/typeorm-source",
      "entryFile": "index",
      "sourceRoot": "libs/typeorm-source/src",
      "compilerOptions": {
        "tsConfigPath": "libs/typeorm-source/tsconfig.lib.json"
      }
    },
    "queue-contracts": {
      "type": "library",
      "root": "libs/queue-contracts",
      "entryFile": "index",
      "sourceRoot": "libs/queue-contracts/src",
      "compilerOptions": {
        "tsConfigPath": "libs/queue-contracts/tsconfig.lib.json"
      }
    },
    "guards": {
      "type": "library",
      "root": "libs/guards",
      "entryFile": "index",
      "sourceRoot": "libs/guards/src",
      "compilerOptions": {
        "tsConfigPath": "libs/guards/tsconfig.lib.json"
      }
    }
  }
}