# Note: All values in the `.env.example` file are dummy data provided for demonstration purposes. 
# Replace them with your actual environment-specific credentials and configuration before running the application.

PORT=3000
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_password
DATABASE_NAME=merchant_onboarding
NODE_ENV=development
REDIS_HOST=localhost
REDIS_PORT=6379
CORS_ORIGINS=["https://example.com","https://admin.example.com"]
CLIENT_JWT_SCERET_KEY=replace_with_a_secure_client_secret
CLIENT_JWT_EXPIRES_IN=1h
ADMIN_JWT_SCERET_KEY=replace_with_a_secure_admin_secret
ADMIN_JWT_EXPIRES_IN=1h
